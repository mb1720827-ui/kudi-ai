# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Never use the service-role/secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# console.anthropic.com > API keys. Only used for alerts the rule-based parser can't read.
ANTHROPIC_API_KEY=your-anthropic-api-key
